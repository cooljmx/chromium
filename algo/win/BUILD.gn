shared_library("broker") {
  sources = [
    "broker/algobroker.cc",
    "broker/algobroker.h",
  ]

  defines = [ "ALGO_BROKER_EXPORTS" ]

  deps = [
    "//sandbox/win:sandbox",
  ]

  output_name = "algobroker.netcore"
}

executable("run_broker") {
  sources = [
    "broker/algobroker.h",
    "broker/host.cc",
  ]

  deps = [
    "//sandbox/win:sandbox",
    ":broker",
  ]

  libs = [
    "algobroker.netcore.dll.lib",
  ]

  output_name = "run_broker.netcore"
}

executable("host") {
  sources = [
    "host/algohost.cc",
    "host/algohost.h",
    "host/coreclr_delegates.h",
    "host/vars.h",
  ]

  deps = [
    "//sandbox/win:sandbox",
  ]

  output_name = "algohost.netcore"
}
